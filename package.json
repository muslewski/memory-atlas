{
  "name": "memory-atlas",
  "version": "0.5.4",
  "type": "module",
  "description": "Per-repo knowledge atlas for agent fleets — verified architecture cards with an honest freshness signal. The past, mapped.",
  "author": "muslewski <10kento10@gmail.com>",
  "keywords": [
    "knowledge-base",
    "agents",
    "memory",
    "obsidian",
    "claude-code",
    "architecture",
    "adr",
    "atlas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muslewski/memory-atlas.git"
  },
  "homepage": "https://atlas.muslewski.com/",
  "bugs": {
    "url": "https://github.com/muslewski/memory-atlas/issues"
  },
  "bin": {
    "atlas": "bin/atlas.mjs",
    "memory-atlas": "bin/atlas.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "schema",
    "skills",
    "adapters",
    "examples",
    "docs",
    "SPEC.md",
    "scripts/postinstall.mjs"
  ],
  "scripts": {
    "test": "node --test test/",
    "lint": "npx @biomejs/biome check .",
    "docs:check": "node ../docs-kit/bin/docs-kit.mjs check docs/",
    "docs:health": "node ../docs-kit/bin/docs-kit.mjs health docs/",
    "postinstall": "node scripts/postinstall.mjs",
    "predev": "atlas gate",
    "atlas": "atlas",
    "atlas:gate": "atlas gate",
    "atlas:doctor": "atlas doctor",
    "atlas:wire": "atlas wire all",
    "//sage-gate": "global only — sage gate (preferred judge) is machine-level; not chained into predev. run: sage gate"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3"
  }
}
